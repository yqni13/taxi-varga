{
  "name": "taxi-varga",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node ./set-env.dev.ts && ng serve --open",
    "start-local-ssl": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 cmd /c \"node ./set-env.dev.ts && ng serve --ssl true --ssl-cert D:/Dokumente/GitHub/taxi-varga/local_ssl/localhost.crt --ssl-key D:/Dokumente/GitHub/taxi-varga/local_ssl/localhost.key --open\"",
    "start-ssl-linux": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 sh -c \"node ./set-env.dev.ts && ng serve --ssl true --ssl-cert ../local_ssl/localhost.crt --ssl-key ../local_ssl/localhost.key --open\"",
    "start:stag": "node set-env.ts && ng serve --configuration staging",
    "start:prod": "node set-env.ts && ng serve --configuration production",
    "build": "ng build",
    "build:stag": "node set-env.ts && ng build --configuration staging",
    "build:prod": "node set-env.ts && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@ngx-env/builder": "^19.0.4",
    "@ngx-translate/core": "^16.0.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "express": "^4.18.2",
    "http-proxy-middleware": "^3.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "underscore": "^1.13.7",
    "uuid": "^14.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.17",
    "@types/node": "^26.6.5",
    "@types/underscore": "^1.13.0",
    "angular-eslint": "^22.6.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.28.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^5.0.4"
  }
}
